<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fr.pje.relatorio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PLACEHOLDER/bin/relatorio-diario.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPO_PLACEHOLDER/logs/relatorio.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PLACEHOLDER/logs/relatorio.err</string>
  <key>WorkingDirectory</key>
  <string>REPO_PLACEHOLDER</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
