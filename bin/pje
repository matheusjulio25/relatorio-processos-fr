#!/bin/bash
# Wrapper do coletor PJe. Uso: pje <comando> [args]
#   pje listar | diff [--apply] | detalhe CNJ | pecas CNJ | relatorio [--limit N]
#   pje install-agent | uninstall-agent | logs
set -e

REPO="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$REPO/.venv"
PLIST_NAME="com.fr.pje.relatorio.plist"
PLIST_SRC="$REPO/launchd/$PLIST_NAME"
PLIST_DST="$HOME/Library/LaunchAgents/$PLIST_NAME"
LOG_DIR="$REPO/logs"

cmd="${1:-}"; shift || true

case "$cmd" in
  install-agent)
    mkdir -p "$LOG_DIR" "$HOME/Library/LaunchAgents"
    # substitui o REPO_PLACEHOLDER do template
    sed "s|REPO_PLACEHOLDER|$REPO|g" "$PLIST_SRC" > "$PLIST_DST"
    launchctl unload "$PLIST_DST" 2>/dev/null || true
    launchctl load "$PLIST_DST"
    echo "agente instalado. roda todo dia 08:00."
    echo "logs em $LOG_DIR/"
    ;;
  uninstall-agent)
    launchctl unload "$PLIST_DST" 2>/dev/null || true
    rm -f "$PLIST_DST"
    echo "agente desinstalado."
    ;;
  logs)
    tail -n 100 "$LOG_DIR/relatorio.log" "$LOG_DIR/relatorio.err" 2>/dev/null || echo "sem logs ainda."
    ;;
  "")
    echo "uso: pje <listar|diff|detalhe|pecas|relatorio|install-agent|uninstall-agent|logs> [args]"
    exit 1
    ;;
  *)
    source "$VENV/bin/activate"
    cd "$REPO"
    exec python -m coletor_pje.cli --no-headless "$cmd" "$@"
    ;;
esac
