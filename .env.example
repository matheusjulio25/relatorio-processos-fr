# Pasta do perfil persistente do Chrome (cookies, escolha do cert, etc).
# Default: ./browser-profile (já no .gitignore).
# BROWSER_PROFILE=/Users/seu_usuario/relatorio-processos-fr/browser-profile

# Segredo TOTP do 2FA do PJe (base32). Pegue ao "Configurar novo dispositivo"
# no PJe: o QR code expõe um parâmetro `secret=...`. Cole esse valor aqui.
# PJE_TOTP_SECRET=JBSWY3DPEHPK3PXP
