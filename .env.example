# ============================================================
# CONFIGURAÇÕES — Relatório Diário de Processos F&R
# ============================================================
# 1. Copie este arquivo:  cp .env.example .env
# 2. Preencha as credenciais abaixo
# 3. NUNCA suba o arquivo .env para o GitHub
# ============================================================

# ── Servidor de entrada de e-mails (IMAP) ────────────────────
IMAP_SERVER=mail4.deploycloud.com.br
IMAP_PORT=993

# ── Conta 1 — Matheus ────────────────────────────────────────
EMAIL_1=matheus@fernandeserego.adv.br
SENHA_1=SUA_SENHA_AQUI

# ── Conta 2 — Administrativo ─────────────────────────────────
EMAIL_2=administrativo@fernandeserego.adv.br
SENHA_2=SUA_SENHA_AQUI

# ── Histórico: quantos dias retroativos buscar (1 = só hoje) ─
DIAS_HISTORICO=1

# ── Notion (opcional — deixe em branco para não usar) ────────
NOTION_TOKEN=
NOTION_PAGE_ID=

# ── Envio do relatório por e-mail (SMTP) ─────────────────────
SMTP_SERVER=mail4.deploycloud.com.br
SMTP_PORT=587
EMAIL_ENVIO=matheus@fernandeserego.adv.br
SENHA_ENVIO=SUA_SENHA_AQUI
EMAIL_DESTINO=leticia@fernandeserego.adv.br
